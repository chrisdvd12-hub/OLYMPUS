{
  "name": "olympus-divine-collection",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/boosters.test.ts && node --test tests/proxy.test.cjs",
    "start:go": "node --require ./scripts/normalize-proxy.cjs ./node_modules/expo/bin/cli start --go --tunnel"
  },
  "dependencies": {
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "type": "module"
}
