{
  "name": "olympus-divine-collection",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/inject-pwa.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/boosters.test.ts && node --experimental-strip-types tests/premium.test.ts && node --experimental-strip-types tests/progression.test.ts && node --experimental-strip-types tests/artwork-layout.test.ts && node --experimental-strip-types tests/collection-effects.test.ts && node --experimental-strip-types tests/sync.test.ts && node --test tests/proxy.test.cjs && npm run check:artwork && npm run check:illustrations && npm run check:memory",
    "start:go": "node --require ./scripts/normalize-proxy.cjs ./node_modules/expo/bin/cli start --go --tunnel ngrok",
    "check:artwork": "node scripts/check-artwork.cjs",
    "check:illustrations": "node scripts/check-illustrations.cjs",
    "check:memory": "node scripts/audit-image-memory.cjs",
    "doctor:offline": "EXPO_OFFLINE=1 EXPO_NO_TELEMETRY=1 expo install --check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "type": "module"
}
