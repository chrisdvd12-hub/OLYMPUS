{
  "name": "OLYMPUS — Expo Go",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "postCreateCommand": "node --version && npm --version && npm ci",
  "forwardPorts": [
    8081
  ],
  "portsAttributes": {
    "8081": {
      "label": "Expo Metro",
      "onAutoForward": "notify"
    }
  }
}
